    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Mental_disorder -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Mental_disorder">
