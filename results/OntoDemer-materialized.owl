    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Adequate_Behavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Adequate_Behavior">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Behavior"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Harmful_Behavior"/>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label>Adequate Behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Behavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Behavior">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#activity"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Physical_Activity"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#frequency"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Frequency"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>Behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Consequent_Illness -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Consequent_Illness">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#relatedIllness"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Physical_disorder"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:label>Consequent Illness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Daily_Activities -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Daily_Activities">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Physical_Activity"/>
        <rdfs:label>Daily Activities</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Embedded_Techologies -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Embedded_Techologies">
