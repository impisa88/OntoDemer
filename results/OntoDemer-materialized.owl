    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Excessive -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Excessive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Frequency"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Insufficient"/>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Normal"/>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label>Excessive</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Frequency -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Frequency">
        <rdfs:label>Frequency</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Harmful_Behavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Harmful_Behavior">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Results"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Consequent_Illness"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#susceptibilities"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Susceptibility"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Behavior"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Adequate_Behavior"/>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label>Harmful Behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#High_Susceptibility -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#High_Susceptibility">
