                <owl:complementOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Low_Susceptibility"/>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label>High Susceptibility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Insufficient -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Insufficient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Frequency"/>
        <rdfs:subClassOf>
