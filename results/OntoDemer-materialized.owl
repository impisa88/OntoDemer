            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label>Insufficient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Low_Susceptibility -->

    <owl:Class rdf:about="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Low_Susceptibility">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jgh88/ontologies/2023/8/untitled-ontology-3#Susceptibility"/>
        <rdfs:subClassOf>
